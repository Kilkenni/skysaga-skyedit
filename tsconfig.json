{
  "compilerOptions": {
    "target": "ES2022", 
    "module": "ESNext", 
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], 
    "strict": true, 
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
  },
  "include": ["src"]
}